# Add at least one key. Providers are tried in LLM_PROVIDERS order; if one fails or is rate-limited, the next one is used.
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Optional
LLM_PROVIDERS=groq,gemini,nvidia,openrouter
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CORS_ORIGINS=http://localhost:5173
MAX_PDF_MB=5
# Number of search queries and results per query used by the scout.
MAX_SEARCH_QUERIES=15
MAX_RESULTS_PER_QUERY=15
# Optional Firecrawl API key for enhanced scraping
FIRECRAWL_API_KEY=
JOB_RSS_FEEDS=
# Optional local resume text/skills used for deterministic relevance scoring.
RESUME_PROFILE_TEXT=
# Listings with a known posting date older than this are excluded.
JOB_FRESHNESS_DAYS=45
